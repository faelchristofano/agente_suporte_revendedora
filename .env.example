# =============================================================================
# Copie este arquivo para ".env" (cp .env.example .env) e preencha os valores.
# O arquivo ".env" NUNCA deve ser commitado.
# =============================================================================

# --- Google Gemini (LLM + embeddings) ---------------------------------------
# Gere a chave em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Langfuse (Observabilidade) ---------------------------------------------
# >>> AVALIADOR: cole aqui as chaves do seu projeto Langfuse. <<<
# Onde encontrar: Langfuse > seu projeto > Settings > API Keys > "Create new API keys".
# Se estas chaves ficarem vazias, a API continua funcionando, apenas sem traces.

# Chave pública do projeto (começa com "pk-lf-...")
LANGFUSE_PUBLIC_KEY=

# Chave secreta do projeto (começa com "sk-lf-..."); exibida apenas uma vez na criação
LANGFUSE_SECRET_KEY=

# URL do servidor Langfuse:
#   - Cloud Europa (padrão): https://cloud.langfuse.com
#   - Cloud EUA:             https://us.cloud.langfuse.com
#   - Self-hosted:           a URL da sua instância (ex.: http://localhost:3000)
LANGFUSE_HOST=https://cloud.langfuse.com
